# External MySQL instance (for example, Aiven MySQL).
MYSQL_HOST=your-mysql-host.example.com
MYSQL_PORT=3306
MYSQL_DATABASE=campushub
MYSQL_USER=replace-with-mysql-user
MYSQL_PASSWORD=replace-with-mysql-password
MYSQL_SSL_MODE=REQUIRED

NEO4J_URI=neo4j+s://your-neo4j-host
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-neo4j-password

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-mail-username
MAIL_PASSWORD=replace-with-mail-app-password

GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
FRONTEND_URL=https://app.example.com
# Comma-separated browser origins permitted to call the API.
CORS_ALLOWED_ORIGINS=https://app.example.com

AWS_S3_BUCKET=replace-with-s3-bucket-name
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=replace-with-aws-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-aws-secret-access-key

JWT_SECRET=replace-with-a-long-random-base64-secret

RECOMMENDATION_SERVICE_BASE_URL=http://localhost:8001
RECOMMENDATION_INTERNAL_KEY=change-me-in-production
RECOMMENDATION_CONNECT_TIMEOUT_MS=1000
RECOMMENDATION_READ_TIMEOUT_MS=1500
